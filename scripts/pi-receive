#!/bin/sh
# GIT_DIR is the bare repo during the hook. Drop it or checkout updates the bare repo.
set -eu
unset GIT_DIR
git --git-dir=/home/bs/tank.git --work-tree=/home/bs/tank checkout -f
cp /home/bs/tank/scripts/pi-receive /home/bs/tank.git/hooks/post-receive
chmod 755 /home/bs/tank.git/hooks/post-receive
if command -v fuser >/dev/null 2>&1; then
  fuser -k 8080/tcp >/dev/null 2>&1 || true
fi
sleep 0.5
cd /home/bs/tank
nohup /home/bs/nano-venv/bin/python check/preview.py >/tmp/preview.log 2>&1 &
